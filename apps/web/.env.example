# Copy to apps/web/.env.local for development, or set these in your hosting dashboard.

# Where the website's server reads content from (can be an internal address).
API_INTERNAL_URL=http://localhost:4000/api/v1
# The API address the visitor's browser uses (contact form).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Must equal REVALIDATE_SECRET in the API's environment.
REVALIDATE_SECRET=

# Optional: the public address of the site, used when the CMS has no address saved yet.
NEXT_PUBLIC_SITE_URL=
# Optional: use only the bundled static content (ignores the API).
CONTENT_SOURCE=
# Review modes (development only)
NEXT_PUBLIC_SHOW_DRAFTS=
NEXT_PUBLIC_SAMPLE_CONTENT=
