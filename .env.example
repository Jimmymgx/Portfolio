# Copy to `.env` in the repository root (or to apps/api/.env). Never commit real values.

NODE_ENV=development
LOG_LEVEL=info

# ── API ────────────────────────────────────────────────────────────────
API_PORT=4000
# Public address of the API (used to build media URLs).
API_PUBLIC_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3001
# Set to true when the API runs behind a reverse proxy (Nginx, a load balancer, ...).
TRUST_PROXY=false

# mysql://USER:PASSWORD@HOST:PORT/DATABASE   (database must use utf8mb4, see docs/deployment/database-setup.md)
DATABASE_URL=

# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_HOURS=12
# Leave empty for localhost. Set to ".yourdomain.com" if the website, dashboard and API share a parent domain.
COOKIE_DOMAIN=
# Salt used to hash visitor IPs on contact messages. Required in production.
IP_HASH_SALT=

# ── Media storage ──────────────────────────────────────────────────────
MEDIA_STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIRECTORY=./uploads
# Only when MEDIA_STORAGE_PROVIDER=s3 (AWS S3, Cloudflare R2, MinIO, ...)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# ── Website cache invalidation ─────────────────────────────────────────
# Shared secret between the API and the website's /api/revalidate route. Same value in both apps.
REVALIDATE_SECRET=
# Defaults to PUBLIC_WEB_URL + /api/revalidate
WEB_REVALIDATE_URL=

# ── Website (apps/web) ─────────────────────────────────────────────────
# Public API base used by the website and the dashboard.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Server-side API base for the website (can be an internal address).
API_INTERNAL_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=
# Review modes (development only)
NEXT_PUBLIC_SHOW_DRAFTS=
NEXT_PUBLIC_SAMPLE_CONTENT=
